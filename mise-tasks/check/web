#!/usr/bin/env bash
#MISE description="Gate step web: npm ci, Prettier, ESLint, svelte-check and Vitest"
set -euo pipefail
reports="${ARMOURY_REPORT_DIR:-${RUNNER_TEMP:-${TMPDIR:-/tmp}}/armoury-check}"
cd "$(dirname "${BASH_SOURCE[0]}")/../../web"
mkdir -p "$reports"

npm ci --no-audit --no-fund
npm run lint
npm run check
npx --no -- vitest run --reporter=default --reporter=junit --outputFile.junit="$reports/web-unit.xml"
