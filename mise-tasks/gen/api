#!/usr/bin/env bash
#MISE description="Generate the Rust server types (openapi-generator in an okteto test container) and the TS types from api/openapi.yaml"
set -euo pipefail
: "${ARMOURY_OKTETO_CONTEXT:?is not set; copy mise.local.toml.example to mise.local.toml}"
: "${ARMOURY_NAMESPACE:?is not set; copy mise.local.toml.example to mise.local.toml}"

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
root="$(cd "${1:-$repo}" && pwd)"
# Generated paths, relative to the root. `check/api` compares the same paths.
rust_out="control-plane/src/httpapi/server/generated"
ts_out="web/src/lib/api/schema.d.ts"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# Okteto runs `git` when it works inside a Git repository, so `okteto test` runs in a scratch
# directory that holds only the spec and the generator manifest (no VCS command, AC-6).
mkdir -p "$work/api"
cp "$root/api/openapi.yaml" "$work/api/openapi.yaml"
cp "$repo/mise-tasks/gen/okteto.yml" "$work/okteto.yml"
(cd "$work" && okteto test generate --context "$ARMOURY_OKTETO_CONTEXT" --namespace "$ARMOURY_NAMESPACE" \
  --file okteto.yml --name "armoury-gen-api-$$-$RANDOM" --timeout 5m)

if [ ! -f "$work/out/rust/src/lib.rs" ]; then
  echo "gen:api: okteto test returned no Rust output in out/rust" >&2
  exit 1
fi
rm -rf "${root:?}/$rust_out"
mkdir -p "$(dirname "$root/$rust_out")"
# The generator's own manifest floats its versions; server/Cargo.toml is the one that builds.
rm -f "$work/out/rust/Cargo.toml"
cp -R "$work/out/rust" "$root/$rust_out"

mkdir -p "$(dirname "$root/$ts_out")"
[ -d "$repo/web/node_modules" ] || (cd "$repo/web" && npm ci --no-audit --no-fund)
(cd "$repo/web" && npx --no -- openapi-typescript "$work/api/openapi.yaml" --output "$root/$ts_out")
echo "gen:api: wrote $rust_out and $ts_out under $root"
