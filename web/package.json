{
	"name": "armoury-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@xyflow/svelte": "1.6.6",
		"openapi-fetch": "0.17.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@fontsource-variable/inter": "5.3.0",
		"@lucide/svelte": "1.76.0",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "3.0.11",
		"@sveltejs/kit": "2.70.4",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.6",
		"cn": "0.5.2",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"openapi-typescript": "7.13.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn-svelte": "1.8.1",
		"svelte": "5.58.0",
		"svelte-check": "4.7.8",
		"tailwind-variants": "4.0.2",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.73.0",
		"vite": "8.3.8",
		"vitest": "4.1.12"
	}
}
